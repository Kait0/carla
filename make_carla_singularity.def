Bootstrap: docker
From: ubuntu:18.04


%environment
    # Set environment variables
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # export CARLA_ROOT=/opt/carla
    # export PATH=$CARLA_ROOT:$PATH
    # export LD_LIBRARY_PATH=$CARLA_ROOT/Lib:$LD_LIBRARY_PATH
    export DISPLAY=${DISPLAY}
    export NVIDIA_DRIVER_CAPABILITIES=all
    export NVIDIA_VISIBLE_DEVICES=all
    export XDG_RUNTIME_DIR=/run/user/1000
    export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

%post
    apt-get update && apt-get install -y software-properties-common
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update && apt-get install -y \
    build-essential libssl-dev zlib1g-dev libncurses5-dev \
    libreadline-dev libsqlite3-dev libffi-dev wget
    cd /usr/src
    wget https://www.python.org/ftp/python/3.10.14/Python-3.10.14.tgz
    tar -xvf Python-3.10.14.tgz
    cd Python-3.10.14
    ./configure --enable-optimizations
    make -j$(nproc)
    make altinstall   # installs python3.10 without overwriting system python
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    curl \
    vulkan-utils \
    python3-dev \
    python3-venv \
    python3-pip \
    python3-setuptools \
    python3-distro \
    python3-wheel \
    python3-distutils \
    libtiff5-dev \
    libjpeg-dev \
    autoconf \
    rsync \
    libvulkan1 \
    libxml2-dev \
    xvfb \
    x11-utils \
    libglu1-mesa \
    libgtk-3-dev \
    clang \
    clang-format \
    clang-tidy \
    lld \
    mesa-vulkan-drivers \
    libsdl2-dev \
    ninja-build \
    libssl-dev \
    libpng-dev \
    libfreetype6-dev \
    libx11-dev \
    libxrandr-dev \
    libxcursor-dev \
    libxi-dev \
    libxinerama-dev \
    libxss-dev \
    libxcomposite-dev \
    libxdamage-dev \
    sudo \
    pkg-config \
    unzip \
    xdg-user-dirs \
    ca-certificates \
    xdg-utils \
    automake \
    libtool \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    python3.10 -m pip install --upgrade pip setuptools wheel distro

    python3.10 --version
    python3.10 -m pip install --upgrade --user pip
    pip3.10 install --no-cache-dir \
        numpy \
        pygame \
        protobuf

%runscript

