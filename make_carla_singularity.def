Bootstrap: docker
From: ubuntu:18.04


%environment
    # Set environment variables
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    # export CARLA_ROOT=/opt/carla
    # export PATH=$CARLA_ROOT:$PATH
    # export LD_LIBRARY_PATH=$CARLA_ROOT/Lib:$LD_LIBRARY_PATH
    export DISPLAY=${DISPLAY}
    export NVIDIA_DRIVER_CAPABILITIES=all
    export NVIDIA_VISIBLE_DEVICES=all
    export XDG_RUNTIME_DIR=/run/user/1000
    export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

%post
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    autotools-dev \
    automake \
    autoconf \
    libtool \
    cmake \
    git \
    wget \
    unzip \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-distro \
    python3-wheel \
    libtiff5-dev \
    libjpeg-dev \
    autoconf \
    rsync \
    x11-apps \
    libvulkan1 \
    libxml2-dev \
    xvfb \
    x11-utils \
    mesa-utils \
    libglu1-mesa \
    libgtk-3-dev \
    clang \
    clang-format \
    clang-tidy \
    lld \
    mesa-vulkan-drivers \
    libsdl2-dev \
    ninja-build \
    libssl-dev \
    libpng-dev \
	libxcb1-dev \
    libfreetype6-dev \
    libx11-dev \
	libxkbcommon-dev \
	libx11-xcb-dev \
	libgl1-mesa-dev \
    libxrandr-dev \
	vulkan-utils \
	libvulkan-dev \
    libxcursor-dev \
    libxi-dev \
    libxinerama-dev \
    libxss-dev \
    libxcomposite-dev \
    libxdamage-dev \
    sudo \
    pkg-config \
    unzip \
    xdg-user-dirs \
    ca-certificates \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade --user pip
    pip3 install --no-cache-dir \
        numpy \
        pygame \
        protobuf

%runscript

